# PostgreSQL connection string (Neon)
DATABASE_URL=

# LLM provider selection: gemini | openrouter | mock
LLM_PROVIDER=gemini

# Google Gemini API key (free tier)
GEMINI_API_KEY=

# Optional. Defaults to the floating alias `gemini-flash-lite-latest`: an alias
# so it keeps resolving as Google retires pinned versions, and the lite variant
# because the full flash model is a thinking model whose latency overruns the
# client timeout and whose free tier is 20 requests/day. Set only to pin one.
GEMINI_MODEL=

# OpenRouter API key (free tier, used as fallback)
OPENROUTER_API_KEY=

# Maximum AI calls permitted per workflow run
MAX_LLM_CALLS_PER_RUN=20
